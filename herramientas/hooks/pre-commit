#!/bin/sh
# Sella version.txt en cada commit que toque OTROS ficheros. Así la app
# instalada (PWA) detecta que hay una versión nueva y ofrece recargar
# (lo comprueba assets/js/db.js). Nunca aborta el commit (exit 0).
staged=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null | grep -v '^version\.txt$')
if [ -n "$staged" ]; then
  date -u +%Y%m%d%H%M%S > version.txt 2>/dev/null && git add version.txt 2>/dev/null
fi
exit 0
